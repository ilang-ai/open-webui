# FluxPath app settings (Open WebUI v0.11.4). Copy to fluxpath.env and fill in the secrets.
# With ENABLE_PERSISTENT_CONFIG=false these values win on every start, so the settings below
# cannot drift through the admin panel.
ENABLE_PERSISTENT_CONFIG=false

# ---- secrets (never commit the filled-in file) ----
WEBUI_SECRET_KEY=
# The first account is created from these on first start. Without them, whoever signs up
# first on a fresh instance becomes the administrator.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=FluxPath Admin

# ---- identity ----
# Upstream renders a custom name as "FluxPath (Open WebUI)", the form its license allows.
WEBUI_NAME=FluxPath
WEBUI_URL=https://app.fluxpath.app
CORS_ALLOW_ORIGIN=https://app.fluxpath.app

# ---- accounts ----
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user
ENABLE_API_KEYS=false

# ---- models: every user brings their own key, there is no shared backend ----
ENABLE_OLLAMA_API=false
ENABLE_DIRECT_CONNECTIONS=true

# ---- conversations are not stored on this server ----
# Ordinary users only get temporary chats, which are never written to the database.
USER_PERMISSIONS_CHAT_TEMPORARY_ENFORCED=true
# Everything else that would keep what a user said or uploaded.
USER_PERMISSIONS_CHAT_FILE_UPLOAD=false
ENABLE_MEMORIES=false
USER_PERMISSIONS_FEATURES_MEMORIES=false
ENABLE_NOTES=false
USER_PERMISSIONS_FEATURES_NOTES=false
ENABLE_CHANNELS=false
USER_PERMISSIONS_FEATURES_CHANNELS=false
ENABLE_MESSAGE_RATING=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false
AUDIT_LOG_LEVEL=NONE

# ---- background model calls that would resend the conversation ----
ENABLE_TITLE_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false

# ---- small machine: no local embedding model, no calls home ----
RAG_EMBEDDING_ENGINE=openai
ENABLE_VERSION_UPDATE_CHECK=false
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
